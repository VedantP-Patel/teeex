{
  "name": "teeex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "fonts": "node scripts/download-fonts.mjs",
    "predev": "node scripts/download-fonts.mjs && node scripts/sync-pdfjs-assets.mjs && node scripts/fetch-engine.mjs && node scripts/download-essential-packages.mjs",
    "dev": "vite",
    "prebuild": "node scripts/download-fonts.mjs && node scripts/sync-pdfjs-assets.mjs && node scripts/fetch-engine.mjs && node scripts/download-essential-packages.mjs",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build && node scripts/prune-pages-dist.mjs",
    "engine": "node scripts/fetch-engine.mjs",
    "engine:verify": "node scripts/fetch-engine.mjs --verify",
    "engine:r2-upload": "node scripts/upload-r2.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@supabase/supabase-js": "^2.117.3",
    "codemirror": "^6.0.2",
    "codemirror-lang-latex": "^0.6.1",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "lib0": "^0.2.119",
    "lucide-react": "^1.53.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "texlyre-busytex": "^1.4.0",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@playwright/test": "^1.64.0",
    "@types/jszip": "^3.4.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^21.0.1",
    "oxlint": "^1.81.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
